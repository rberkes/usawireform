# Email (Resend) - For sending form submissions
# Sign up at https://resend.com and get your API key
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=quotes@yourdomain.com

# File Storage (Vercel Blob) - For resume/drawing uploads AND for persisting
# directory + outbound leads so they show up at /admin/leads
# Created automatically when you add Vercel Blob to your project
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxxxxxx

# Admin leads dashboard - password to view captured leads at /admin/leads
# Pick any strong password; there is no username, just this shared secret.
ADMIN_LEADS_PASSWORD=change-me-to-something-long-and-random

# Where directory-inquiry and outbound-link leads get emailed (requires
# RESEND_API_KEY + RESEND_FROM_EMAIL above to actually send). Defaults to
# rberkes@gmail.com if unset.
LEAD_NOTIFICATION_EMAIL=rberkes@gmail.com

# Note: Without these variables, forms still work but:
# - Submissions are logged to console only (no email sent)
# - Files are not stored (file names are recorded but not uploaded)
# - Leads are not persisted, and /admin/leads stays disabled
