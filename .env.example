# Email (Resend) - For sending form submissions
# Sign up at https://resend.com and get your API key
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=quotes@yourdomain.com

# File Storage (Vercel Blob) - For resume and drawing uploads
# Created automatically when you add Vercel Blob to your project
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxxxxxx

# AI Blog Generation (OpenAI) - For automated blog posts
# Sign up at https://platform.openai.com and get your API key
OPENAI_API_KEY=sk-xxxxxxxxx

# Cron Job Security - Protect the blog generation endpoint
# Generate a random secret: openssl rand -base64 32
CRON_SECRET=your-random-secret-here

# Note: Without these variables, forms still work but:
# - Submissions are logged to console only (no email sent)
# - Files are not stored (file names are recorded but not uploaded)
# - Blog posts cannot be auto-generated (requires OPENAI_API_KEY)
