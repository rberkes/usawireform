# AI search (Vercel AI Gateway → OpenAI)
# Local: create a key at https://vercel.com/ai-gateway
# On Vercel production, OIDC is enough — no key required.
AI_GATEWAY_API_KEY=xxxxxxxxx

# Email (Resend) - For sending form submissions
# Sign up at https://resend.com and get your API key
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=quotes@yourdomain.com

# File Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxxxxxx

# Lead notify inbox (directory + quote forms)
LEADS_NOTIFY_EMAIL=rberkes@gmail.com

# Admin list at /admin/leads
ADMIN_LEADS_PASSWORD=xxxxxxxx

# Note: Without these variables, forms still work but:
# - Submissions are logged to console only (no email sent)
# - Files are not stored (file names are recorded but not uploaded)
